{
  "name": "@ygo-assistant/db",
  "version": "0.1.0",
  "description": "LanceDB card index and SQLite application state.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "watch": "tsc -b --watch --preserveWatchOutput",
    "clean:all": "rm -rf dist && rm -rf node_modules",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@lancedb/lancedb": "^0.39.0",
    "@ygo-assistant/cards": "workspace:*",
    "@ygo-assistant/logger": "workspace:*",
    "@ygo-assistant/ollama": "workspace:*",
    "@ygo-assistant/utils": "workspace:*",
    "apache-arrow": "18.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "typescript": "^6.0.3"
  }
}
