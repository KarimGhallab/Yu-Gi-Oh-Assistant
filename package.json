{
  "name": "ygo-assistant",
  "version": "0.1.0",
  "description": "Local-only AI assistant that suggests Yu-Gi-Oh cards from a natural language prompt.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @ygo-assistant/server --filter @ygo-assistant/web run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @ygo-assistant/server run start",
    "watch": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r run clean",
    "lint": "eslint --cache --fix",
    "format": "npx prettier --list-different --write .",
    "script:unused-code": "npx knip",
    "script:check-updates": "npx ncu --workspaces --interactive",
    "script:code-circular-dependencies": "npx madge --extensions ts --exclude .d.ts --warning --circular apps/ packages/",
    "script:workspace-generate-dependency-graph": "npx depcruise . --output-type archi | dot -T svg > dependency-graph.svg",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "madge": "^8.0.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6",
    "syncpack": "15.3.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "volta": {
    "node": "26.5.0",
    "pnpm": "11.20.0"
  }
}
