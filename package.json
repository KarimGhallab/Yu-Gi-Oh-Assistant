{
  "name": "ygo-assistant",
  "version": "0.1.0",
  "description": "Local-only AI assistant that suggests Yu-Gi-Oh cards from a natural language prompt.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @ygo-assistant/server --filter @ygo-assistant/web run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @ygo-assistant/server run start",
    "db:populate": "pnpm --filter @ygo-assistant/server run db:populate",
    "watch": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build:e2e": "VITE_API_BASE_URL=http://127.0.0.1:3210 pnpm build",
    "test:e2e": "pnpm build:e2e && pnpm --filter @ygo-assistant/e2e test:e2e",
    "test:e2e:ui": "pnpm build:e2e && pnpm --filter @ygo-assistant/e2e test:e2e:ui",
    "e2e:install": "pnpm --filter @ygo-assistant/e2e e2e:install",
    "clean": "pnpm -r run clean",
    "clean:all": "pnpm -r run clean:all",
    "lint:fix": "eslint --cache --fix",
    "lint:check": "eslint --cache",
    "format": "npx prettier --list-different --write .",
    "deps-cruise:check": "npx dependency-cruiser .",
    "deps-cruise:graph": "npx dependency-cruiser . --output-type archi | dot -T svg > dependency-graph.svg",
    "script:check-consistent-dependencies": "npx syncpack lint",
    "script:unused-code": "npx knip",
    "script:check-updates": "npx ncu --workspaces --interactive",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "syncpack": "15.3.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
