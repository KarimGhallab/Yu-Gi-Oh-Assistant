{
  "name": "template-node-ts-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "console:start": "pnpm --filter @template-monorepo/console run start",
    "build": "pnpm -r run build",
    "watch": "pnpm -r --parallel run watch",
    "clean": "pnpm -r run clean",
    "lint": "eslint --cache --fix",
    "format": "npx prettier --list-different --write .",
    "script:unused-code": "npx knip",
    "script:check-updates": "npx ncu --workspaces --interactive",
    "script:code-circular-dependencies": "npx madge --extensions ts --exclude .d.ts --warning --circular apps/ packages/",
    "script:workspace-generate-dependency-graph": "npx depcruise . --output-type archi | dot -T svg > dependency-graph.svg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "npm-check-updates": "^23.0.1",
    "prettier": "^3.9.6",
    "syncpack": "15.3.2",
    "typescript-eslint": "^8.66.0"
  },
  "volta": {
    "node": "26.5.0",
    "pnpm": "11.20.0"
  }
}
