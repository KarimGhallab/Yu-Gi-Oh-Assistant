{
  "name": "@ygo-assistant/server",
  "version": "0.1.0",
  "description": "HTTP API, SSE turn stream, and composition root for the Yu-Gi-Oh assistant.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && tsx watch --env-file-if-exists=.env src/main.ts",
    "watch": "tsc -b --watch --preserveWatchOutput",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:populate": "tsc -b && tsx --env-file-if-exists=.env src/populate/populateCommand.ts",
    "rag:ask": "tsc -b && tsx --env-file-if-exists=.env src/rag/ragCommand.ts",
    "clean:all": "rm -rf dist && rm -rf node_modules",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@ygo-assistant/cards": "workspace:*",
    "@ygo-assistant/contracts": "workspace:*",
    "@ygo-assistant/db": "workspace:*",
    "@ygo-assistant/logger": "workspace:*",
    "@ygo-assistant/ollama": "workspace:*",
    "@ygo-assistant/rag": "workspace:*",
    "@ygo-assistant/utils": "workspace:*",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@ygo-assistant/test-support": "workspace:*",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "26.5.0",
    "pnpm": "11.20.0"
  }
}
