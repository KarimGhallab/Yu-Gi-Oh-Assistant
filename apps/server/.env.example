# Copy to .env and adjust. Every variable below has a default, so an empty
# environment is valid; the values shown are those defaults.

# Interface the server binds to. Keep loopback unless you intend to expose the
# unauthenticated conversation history on the network.
HOST=127.0.0.1
PORT=3000

# Directory holding the local card index and the SQLite database.
DATA_DIR=./data

# Directory production log files are written to. Rotated at 10 MB, five files
# kept, and every record is mirrored to stdout. Needs a writable volume when
# the server runs in a container.
LOG_DIR=./logs

# Runtime environment: development | production | test
NODE_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API. Leave it unset when
# the client shares the server's origin (the dev proxy, or a reverse proxy in
# front of both). Set it when the client is hosted separately.
# CORS_ORIGIN=http://localhost:5173

# Comma-separated extra hostnames the API accepts in a request's Host header,
# on top of the loopback forms. Set it to the API's public name when a client
# hosted separately reaches it through a proxy. The API answers 403 to any
# other Host or Origin, which is what keeps a web page from reaching loopback
# by DNS rebinding.
# ALLOWED_HOSTS=assistant.example

# Pin the next populate to a dump you have verified. Set it to the SHA-256 of
# the raw cardinfo.php body you trust; a populate that fetches anything else
# fails instead of building the index. Leave it unset to accept the live dump
# over TLS.
# CARD_DUMP_SHA256=

# Pin the dataset version the loaded index must carry, as `pnpm db:populate`
# reports it. A boot whose index holds a different version fails. Leave it
# unset to accept whatever index is present.
# CARD_DATASET_VERSION=

# Ollama instance. It may be local or remote.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional separate host for the embedding model. Defaults to OLLAMA_BASE_URL
# when unset.
# OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_EMBEDDING_DIMENSIONS=768

# Retrieval tuning.
RETRIEVAL_TOP_K=30
# How many cards, from the top k ones, the model is asked to filter
RETRIEVAL_FILTER_POOL=20
# Max number of cards shown in the UI
RETRIEVAL_MAX_SHOWN=8
RETRIEVAL_MIN_SCORE=0.7
